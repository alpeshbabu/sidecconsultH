# -----------------------------------------------------------------------------
# Production environment for the Hostinger VPS.
# Copy to the project root as `.env` on the server:  cp deploy/env.example .env
# Docker Compose reads it for the stack, and the app container loads it too.
# Generate secrets with:  openssl rand -base64 32
# -----------------------------------------------------------------------------

# --- Domain / TLS (Caddy) -----------------------------------------------------
SITE_DOMAIN=sidecconsulting.com
ACME_EMAIL=alpesh.patel@sidecllc.com

# --- PostgreSQL (runs on this VPS in the `db` container) ----------------------
POSTGRES_USER=sidec
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=sidec_consulting
# Must match the three values above. `db` is the compose service hostname.
DATABASE_URL=postgresql://sidec:CHANGE_ME_long_random_password@db:5432/sidec_consulting?schema=public
# Optional: pg pool size for the app process (default 10).
# DATABASE_POOL_MAX=10

# --- Auth (NextAuth v5) -------------------------------------------------------
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_URL=https://sidecconsulting.com
NEXTAUTH_URL=https://sidecconsulting.com
# Required behind a reverse proxy (Caddy) so NextAuth trusts the Host header.
AUTH_TRUST_HOST=true

# --- Admin user (used by `prisma db seed`) ------------------------------------
ADMIN_EMAIL=alpesh.patel@sidecllc.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NOTIFICATION_EMAIL=alpesh.patel@sidecllc.com

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Cron ----------------------------------------------------------------------
# Shared secret for /api/cron/appointment-reminders (the `cron` container sends it).
CRON_SECRET=CHANGE_ME_openssl_rand_base64_32
# Timezone the 09:00 daily reminder should fire in.
CRON_TZ=America/New_York

# --- OpenAI (admin blog generator + chatbot) ----------------------------------
OPENAI_API_KEY=

# --- Supabase Storage (client-portal documents; stays on Supabase) ------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=client-documents

# --- Public site identity -------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://sidecconsulting.com
NEXT_PUBLIC_CONTACT_EMAIL=alpesh.patel@sidecllc.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

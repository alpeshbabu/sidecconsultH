// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  output     = "../lib/generated/prisma"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  ADMIN
  EDITOR
  CLIENT     // Portal client (passwordless / magic-link login)
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum PortalActorRole {
  ADMIN
  CLIENT
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  ARCHIVED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

enum BookingType {
  CLIENT      // Booked by a client through the public form
  ADMIN       // Booked by admin on behalf of a client
  BLOCKED     // Blocked by admin (unavailable)
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChatStatus {
  ACTIVE
  CLOSED
  CONVERTED
}

// =============================================================================
// MODELS
// =============================================================================

/// User model for admin authentication and portal clients
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   // null for CLIENT users (passwordless / magic-link)
  name          String?
  companyName   String?   // for CLIENT users
  role          Role      @default(EDITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  posts         BlogPost[]       @relation("AuthoredPosts")
  projects      Project[]        // projects owned by a CLIENT user
  magicTokens   MagicLinkToken[]

  @@map("users")
}

/// Contact inquiry from website visitors
model ContactInquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String?
  companyName     String?
  serviceInterest String        // One of the 7 service areas or "General Inquiry"
  projectTimeline String?       // Optional timeline dropdown value
  message         String        @db.Text
  supplierAddress String?       @db.Text
  estimatedBudget String?
  otherSites      String?       @db.Text
  otherSiteLocations String?    @db.Text
  expectedDocuments String?     @db.Text
  regulatoryStandards String?   @db.Text
  status          InquiryStatus @default(NEW)
  isRead          Boolean       @default(false)
  internalNotes   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_inquiries")
}

/// Availability settings for appointment scheduling
model AvailabilitySettings {
  id                  String   @id @default("default")
  startTime           String   @default("08:00") // HH:mm format
  endTime             String   @default("17:00") // HH:mm format
  slotDurationMinutes Int      @default(30)
  timezone            String   @default("America/Los_Angeles") // IANA timezone
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("availability_settings")
}

/// Appointment slots available for booking (legacy, kept for migration)
model AppointmentSlot {
  id        String      @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  isBooked  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  appointmentLegacy Appointment? @relation("LegacySlot")

  @@index([startAt])
  @@index([isBooked])
  @@map("appointment_slots")
}

/// Appointment booked by a client or admin
model Appointment {
  id              String            @id @default(cuid())
  bookedAt        DateTime          // The start time of the booked slot
  bookedEndAt     DateTime          // The end time of the booked slot
  slotId          String?           @unique // Legacy field for old bookings
  slot            AppointmentSlot?  @relation("LegacySlot", fields: [slotId], references: [id], onDelete: SetNull)
  bookingType     BookingType       @default(CLIENT) // CLIENT, ADMIN, or BLOCKED
  name            String
  email           String
  phone           String?
  companyName     String?
  serviceInterest String?
  notes           String?           @db.Text
  timeZone        String?
  status          AppointmentStatus @default(REQUESTED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([bookedAt])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([bookingType])
  @@map("appointments")
}

/// Blog post / resource article
model BlogPost {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  excerpt         String?     @db.Text
  content         String      @db.Text
  featuredImage   String?     // URL to featured image
  status          PostStatus  @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?     // SEO meta title
  metaDescription String?     @db.Text // SEO meta description
  readingTime     Int?        // Estimated reading time in minutes
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  author          User?       @relation("AuthoredPosts", fields: [authorId], references: [id], onDelete: SetNull)
  authorId        String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      String?
  tags            Tag[]

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@map("blog_posts")
}

/// Blog category for organizing posts
model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  posts       BlogPost[]

  @@index([sortOrder])
  @@map("categories")
}

/// Service offerings displayed on services page
model Service {
  id              String   @id @default(cuid())
  categoryName    String   // e.g., "Manufacturing & Operations"
  categorySlug    String   // URL-friendly category identifier
  categoryIcon    String?  // Icon name from lucide-react
  categoryColor   String?  // Tailwind gradient classes
  categoryBorder  String?  // Tailwind border classes
  
  // Service details
  serviceId       String   @unique // e.g., "manufacturing-engineering"
  icon            String?  // Icon name from lucide-react
  title           String
  tagline         String?
  description     String   @db.Text
  keyOfferings    String[] // Array of key offering strings
  outcomes        String[] // Array of expected outcome strings
  
  // Display settings
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categorySlug])
  @@index([sortOrder])
  @@index([isActive])
  @@map("services")
}

/// Tag for cross-cutting blog post classification
model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  posts     BlogPost[]

  @@index([slug])
  @@map("tags")
}

/// Rate limit tracking for public API endpoints
model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_entries")
}

/// AI chatbot conversation session
model ChatConversation {
  id            String      @id @default(cuid())
  sessionId     String      // Browser-generated anonymous session ID
  status        ChatStatus  @default(ACTIVE)
  pageUrl       String?     // Page where conversation started
  convertedTo   String?     // "contact" | "schedule" | null
  ipAddress     String?
  messageCount  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  closedAt      DateTime?

  messages      ChatMessage[]

  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("chat_conversations")
}

/// Individual message in a chatbot conversation
model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String
  role            String           // "user" | "assistant"
  content         String           @db.Text
  createdAt       DateTime         @default(now())

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_messages")
}

/// Newsletter subscriber
model Subscriber {
  id            String    @id @default(cuid())
  email         String    @unique
  isActive      Boolean   @default(true)
  subscribedAt  DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([isActive])
  @@map("subscribers")
}

// =============================================================================
// CLIENT PORTAL
// =============================================================================

/// A consulting engagement belonging to a CLIENT user
model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  milestones  Milestone[]
  documents   PortalDocument[]
  messages    PortalMessage[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

/// A milestone within a project (the engagement timeline)
model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
  @@map("milestones")
}

/// A document exchanged within a project (stored in Supabase Storage)
model PortalDocument {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName       String
  storagePath    String          // path within the Supabase bucket
  mimeType       String
  sizeBytes      Int
  uploadedById   String          // User id (admin or client)
  uploadedByRole PortalActorRole
  createdAt      DateTime        @default(now())

  @@index([projectId])
  @@map("portal_documents")
}

/// A message in a project's secure thread
model PortalMessage {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String
  authorRole PortalActorRole
  body       String          @db.Text
  readAt     DateTime?
  createdAt  DateTime        @default(now())

  @@index([projectId, createdAt])
  @@map("portal_messages")
}

/// Single-use, short-lived token for passwordless client login
model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    // SHA-256 hash of the raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("magic_link_tokens")
}
